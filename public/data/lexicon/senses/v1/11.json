d24","label":"n.","definitionZh":"距","glossesEn":["on bird's wing, cock's leg"],"domains":["Zoology"]},{"id":"spur:o:5d99436e01fd","label":"n.","definitionZh":"支脉","domains":["Geology"]},{"id":"spur:o:0612ba2c5113","label":"vt.","definitionZh":"用踢马刺策…前进","domains":["Riding"],"contexts":["horse"],"examples":[{"english":"to spur one's horse into a trot","chinese":"用踢马刺策马小跑"}]},{"id":"spur:o:a248762f4655","label":"vt.","definitionZh":"激励","glossesEn":["urge"],"registers":["figurative"],"contexts":["person","group"],"examples":[{"english":"to cut interest rates to spur demand","chinese":"降低利率以刺激需求"},{"english":"to spur sb into action","chinese":"激励某人采取行动"},{"english":"spurred by the response, she …","chinese":"在这种反应的激励下，她…"}]},{"id":"spur:o:ba83e3d7898c","label":"vt.","definitionZh":"促进","contexts":["growth"]},{"id":"spur:o:6f899a74d8d7","label":"vi.","definitionZh":"策马飞奔","registers":["literary"],"examples":[{"english":"to spur onward","chinese":"策马向前飞奔"}]}]},"strings":{"senses":[{"id":"strings:o:e36cf4c9bcba","label":"n. pl.","definitionZh":"弦乐器；弦乐器演奏者；弦乐器组","glossesEn":["instruments","players"],"domains":["Music"],"examples":[{"english":"the strings","chinese":"弦乐器；弦乐器演奏者"},{"english":"the strings section","chinese":"弦乐器组"}]}]},"too":{"senses":[{"id":"too:o:f0f1d3da48ab","label":"adv.","definitionZh":"太","glossesEn":["excessively"],"examples":[{"english":"you've gone too far","chinese":"你太过分了"},{"english":"it's too hot a day for walking","chinese":"天气太热了，不适合散步"},{"english":"too silly for words","chinese":"愚蠢得难以言表"}]},{"id":"too:o:335645b54234","label":"adv.","definitionZh":"也","glossesEn":["also, as well"],"examples":[{"english":"have you been to India too?","chinese":"你也去过印度吗？；你还去过印度吗？"},{"english":"she's kind, but she's strict too","chinese":"她人很好，但也很严厉"},{"english":"the town has changed, so too have the inhabitants","chinese":"城市变样了，居民也变了"}]},{"id":"too:o:57f19171e397","label":"adv.","definitionZh":"而且","glossesEn":["reinforcing an opinion"],"examples":[{"english":"she broke her leg last week, and on her birthday too!","chinese":"她上周摔断了腿，而且是在她生日那天！"},{"english":"they sacked him, and quite right too!","chinese":"他们炒了他鱿鱼，做得很对！"}]},{"id":"too:o:af7bcedd4971","label":"adv.","definitionZh":"用以表示生气、惊讶或赞同","glossesEn":["expressing indignation, annoyance"],"examples":[{"english":"she gave me the money — about time too!","chinese":"她把钱给我了──早该给了！"},{"english":"I'm sorry — I should think so too!","chinese":"我很抱歉──我想应该是这样！"},{"english":"and in front of your mother too!","chinese":"居然当着你母亲的面！"}]},{"id":"too:o:1ec2a388fada","label":"adv.","definitionZh":"不太","glossesEn":["in negatives","in health","in appearance","in his reaction"],"examples":[{"english":"he's not too keen on jazz","chinese":"他不太喜欢爵士乐"},{"english":"it wasn't too bad","chinese":"不算太糟糕"},{"english":"he wasn't too bad","chinese":"他身体不算太差；他外表还过得去；他还过得去"}]},{"id":"too:o:063630c969cc","label":"adv.","definitionZh":"非常","glossesEn":["very"],"registers":["formal"],"examples":[{"english":"you're too kind/generous!","chinese":"你太好了/太慷慨了！；你真是个大好人啊/你可真大方呀！"}]},{"id":"too:o:dc0ace6c099d","label":"adv.","definitionZh":"确实如此","glossesEn":["contradicting"],"registers":["informal"],"examples":[{"english":"he didn't touch you — he did too!","chinese":"他没碰过你──他确实碰了！"},{"english":"but you can't swim — I can too!","chinese":"可你不会游泳──我当然会了！"}]}]},"tract":{"senses":[{"id":"tract:o:2b0777be63fb","label":"n.","definitionZh":"大片","glossesEn":["large area"],"examples":[{"english":"tracts of natural forest","chinese":"大片大片的天然森林"}]},{"id":"tract:o:d9c3228f42d3","label":"n.","definitionZh":"道","glossesEn":["passage"],"domains":["Anatomy"],"examples":[{"english":"the digestive/respiratory tract","chinese":"消化/呼吸道"}]},{"id":"tract:o:929f8fbd2fa8","label":"n.","definitionZh":"小册子","glossesEn":["pamphlet"],"examples":[{"english":"a Catholic/Methodist tract","chinese":"天主教/循道宗教会的小册子"}]}]},"tractable":{"senses":[{"id":"tractable:o:667f1c7a953d","label":"adj.","definitionZh":"顺从的","contexts":["person","child"]},{"id":"tractable:o:7b6241cb0c65","label":"adj.","definitionZh":"驯服的","contexts":["pet"]},{"id":"tractable:o:ffbcf4f5ad8a","label":"adj.","definitionZh":"易处理的","contexts":["material","problem"]}]},"tragedy":{"senses":[{"id":"tragedy:o:453116e55592","label":"n.","definitionZh":"灾难","glossesEn":["dreadful occurrence"],"examples":[{"english":"it's a tragedy that …","chinese":"…是一场灾难"},{"english":"the tragedy of it is that …","chinese":"不幸的是…"},{"english":"the tragedy of war is that …","chinese":"战争带来的灾难是…"}]},{"id":"tragedy:o:edf1d6cd6287","label":"n.","definitionZh":"悲剧","glossesEn":["genre, play"],"examples":[{"english":"King Lear is probably the greatest of Shakespeare's tragedies","chinese":"《李尔王》也许是莎士比亚最伟大的悲剧作品"}]}]},"up-to-date":{"senses":[{"id":"up-to-date:o:5f90277a8dd2","label":"adj.","definitionZh":"最新的","glossesEn":["most recent"],"contexts":["file","information"]},{"id":"up-to-date:o:20a66844d3a7","label":"adj.","definitionZh":"现代的","glossesEn":["modern"],"contexts":["course","method"]},{"id":"up-to-date:o:5f45cffbf071","label":"adj.","definitionZh":"时髦的","glossesEn":["fashionable"],"contexts":["attitude","style"]}]},"vital":{"senses":[{"id":"vital:o:6d477e4e9114","label":"adj.","definitionZh":"必不可少的","glossesEn":["essential"],"contexts":["information","supplies"],"examples":[{"english":"it is vital that …, it is of vital importance that …","chinese":"…是极其重要的"},{"english":"to be vital to sb/sth","chinese":"对某人/某事极其重要"},{"english":"it is vital to do …","chinese":"做…是必要的"}]},{"id":"vital:o:e0196690bdc5","label":"adj.","definitionZh":"决定性的","contexts":["match","factor","point"]},{"id":"vital:o:f343c5712188","label":"adj.","definitionZh":"必要的","contexts":["service","help"]},{"id":"vital:o:fe2f14457bb2","label":"adj.","definitionZh":"极其重要的","contexts":["treatment","clue"]},{"id":"vital:o:92e5fb5f0cf1","label":"adj.","definitionZh":"生气勃勃的","glossesEn":["lively"],"contexts":["person"]},{"id":"vital:o:a6dfaf7eddeb","label":"adj.","definitionZh":"充满生机的","contexts":["organization","culture"]},{"id":"vital:o:14fe372f35ee","label":"n. pl.","definitionZh":"重要器官","glossesEn":["vital organs"]},{"id":"vital:o:1a34476c5541","label":"n. pl.","definitionZh":"外生殖器","glossesEn":["genitals"],"registers":["informal"]}]},"whenever":{"senses":[{"id":"whenever:o:e946d0b176b6","label":"conj.","definitionZh":"无论何时","glossesEn":["at whatever time"],"examples":[{"english":"whenever he does it, it won't matter","chinese":"他什么时候做都没关系"},{"english":"I'll come whenever it's convenient","chinese":"方便时我随时可以过来"}]},{"id":"whenever:o:88a551351a91","label":"conj.","definitionZh":"每当","glossesEn":["every time that"],"examples":[{"english":"whenever I see a black cat, I make a wish","chinese":"我每次看到黑猫都会许个愿"},{"english":"whenever (it is) necessary/possible","chinese":"一有必要/可能"}]},{"id":"whenever:o:a44317994c26","label":"conj.","definitionZh":"谁知道什么时候","glossesEn":["expressing doubt"],"examples":[{"english":"she promised to come as soon as she could, whenever that might be!","chinese":"她答应会尽早来，谁知道要到猴年马月！"}]},{"id":"whenever:o:5710c4bffdbf","label":"adv.","definitionZh":"究竟什么时候","glossesEn":["when on earth"],"examples":[{"english":"whenever will he arrive?","chinese":"他到底什么时候到？"}]},{"id":"whenever:o:4bbe01a132df","label":"adv.","definitionZh":"无论何时","glossesEn":["whatever time"],"registers":["informal"],"examples":[{"english":"or whenever","chinese":"或其他任何时候"},{"english":"how long are you staying? — till whenever","chinese":"你要待多长时间？──到什么时候都行"}]}]},"widespread":{"senses":[{"id":"widespread:o:bd8d7a1afe88","label":"adj.","definitionZh":"分布广的","contexts":["famine","epidemic","infection"],"examples":[{"english":"drug use is widespread","chinese":"毒品服用十分普遍"}]},{"id":"widespread:o:2eec2dd9f696","label":"adj.","definitionZh":"普遍的","contexts":["problem","belief"]},{"id":"widespread:o:7b01649b9aed","label":"adj.","definitionZh":"广泛的","contexts":["support","devastation"]}]}}}