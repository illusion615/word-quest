ares"]},{"id":"underwrite:o:9a234ac15e4d","label":"vt.","definitionZh":"同意承担…的费用","glossesEn":["undertake to support"],"examples":[{"english":"to underwrite a project","chinese":"为项目融资"}]}]},"unsatisfactory":{"senses":[{"id":"unsatisfactory:o:ab6eb5672d3b","label":"adj.","definitionZh":"不令人满意的","examples":[{"english":"the service in the restaurant was very unsatisfactory","chinese":"这家饭店的服务很差"}]}]},"verify":{"senses":[{"id":"verify:o:f510a9b4cdac","label":"vt.","definitionZh":"证实","glossesEn":["confirm"],"contexts":["theory","belief"]},{"id":"verify:o:6118da393476","label":"vt.","definitionZh":"核对","glossesEn":["check"],"contexts":["statement","report"]}]},"warehouse":{"senses":[{"id":"warehouse:o:20df730d4930","label":"n.","definitionZh":"仓库","glossesEn":["storage place"]},{"id":"warehouse:o:0c4ca62f83c5","label":"n.","definitionZh":"批零店","glossesEn":["store"]},{"id":"warehouse:o:d33fc02157a8","label":"vt.","definitionZh":"把…存入仓库","contexts":["goods"]}]}}}