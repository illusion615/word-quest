}]},{"id":"those:o:086ebae6c4f3","label":"det.","definitionZh":"那种的","glossesEn":["categorizing person or thing"],"registers":["formal"],"examples":[{"english":"those patients who are able to walk","chinese":"那些能行走的病人"}]},{"id":"those:o:e0af7a502b82","label":"pron.","definitionZh":"那（个）","glossesEn":["identifying person or thing, referring to the more distant of two, person or thing previously mentioned"],"examples":[{"english":"what's that?","chinese":"那是什么？"},{"english":"who's that?","chinese":"是谁啊？"},{"english":"is that John?","chinese":"那是约翰吗？"}]},{"id":"those:o:b5e3180b2990","label":"pron.","definitionZh":"那种","glossesEn":["categorizing person or thing"],"registers":["formal"],"examples":[{"english":"salaries are higher here than those in my country","chinese":"这儿的薪水比我们国家的高"}]},{"id":"those:o:1b9fbe885bcf","label":"pron.","definitionZh":"那样","glossesEn":["indeed"],"registers":["informal"],"examples":[{"english":"he's a fussy man — he is that","chinese":"他是个挑剔的人──的确如此"}]},{"id":"those:o:7eafdbedcf0e","label":"rel. pron.","definitionZh":"引导限定性定语从句","glossesEn":["introducing defining clause"],"examples":[{"english":"the house that they bought","chinese":"他们买的房子"},{"english":"the woman that won","chinese":"获胜的那个女人"},{"english":"and fool that I am, I believed him","chinese":"我真傻，竟然相信了他"}]},{"id":"those:o:624311b20066","label":"rel. pron.","definitionZh":"代替for which, in which, when引导定语从句","glossesEn":["for which, in which, when"],"examples":[{"english":"the reason that I phoned","chinese":"我打电话的原因"},{"english":"the way that she works","chinese":"她的工作方式"},{"english":"the night that she arrived","chinese":"她到达的那晚"}]},{"id":"those:o:a73f6ec30e77","label":"conj.","definitionZh":"引导表示陈述、假设、原因、结果、目的的从句","glossesEn":["expressing statement or hypothesis, reason or cause, result, purpose"],"examples":[{"english":"he said that he had finished","chinese":"他说他已经完成了"},{"english":"it's likely that they are out","chinese":"他们很可能出去了"},{"english":"it's important that they should realize","chinese":"重要的是他们应当意识到"}]},{"id":"those:o:74c37ff53de0","label":"conj.","definitionZh":"竟然","glossesEn":["expressing surprise"],"examples":[{"english":"that it should come to this!","chinese":"事情怎么会这样啊！"},{"english":"that she should treat me so badly!","chinese":"她怎么能如此恶劣地对待我！"}]},{"id":"those:o:f2b31fddfaf6","label":"conj.","definitionZh":"要是…就好了","glossesEn":["expressing wish"],"registers":["literary"],"examples":[{"english":"oh that I could fly!","chinese":"我会飞的话该多好啊！"},{"english":"oh that he would come","chinese":"哦，他如果能来该多好"}]},{"id":"those:o:02fbd2022bff","label":"adv.","definitionZh":"那么","glossesEn":["to such a degree, extent"],"examples":[{"english":"you're not that stupid","chinese":"你没那么蠢"},{"english":"I can't do that much work in one day","chinese":"我一天之内做不了那么多工作"},{"english":"she's that much smaller than me","chinese":"她个头比我小那么多"}]},{"id":"those:o:70b88edc1c33","label":"adv.","definitionZh":"非常","glossesEn":["very"],"examples":[{"english":"not (all) that","chinese":"不很"},{"english":"it isn’t (all) that cold","chinese":"天气不怎么冷"}]},{"id":"those:o:bbfe24c7aeaf","label":"adv.","definitionZh":"如此","glossesEn":["so very"],"registers":["informal","British"],"examples":[{"english":"he was that ill that he had to go into hospital","chinese":"他病得那么厉害，只好去住院"}]}]},"upside-down":{"senses":[{"id":"upside-down:o:5f4886c6dc2d","label":"adv.","definitionZh":"颠倒地","glossesEn":["in inverted fashion"],"contexts":["turn","place"],"examples":[{"english":"bats hang upside down","chinese":"蝙蝠倒挂身体"}]},{"id":"upside-down:o:e40a43ffb589","label":"adv.","definitionZh":"凌乱不堪地","glossesEn":["in chaotic manner"],"registers":["figurative"],"examples":[{"english":"to turn sb's life upside down","chinese":"把某人的生活搅得一团糟"}]},{"id":"upside-down:o:4f8112a4a00b","label":"adj.","definitionZh":"颠倒的","glossesEn":["inverted"],"contexts":["book"],"examples":[{"english":"the photo is upside down","chinese":"照片挂反了"}]},{"id":"upside-down:o:1be4a6c5c15e","label":"adj.","definitionZh":"倒立的","cont