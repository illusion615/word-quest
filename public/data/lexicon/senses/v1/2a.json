er part"],"examples":[{"english":"from within","chinese":"从里面"},{"english":"no sound came from within","chinese":"里面未传出任何声音"},{"english":"within and without","chinese":"里里外外"}]},{"id":"within:o:df82a48203d2","label":"adv.","definitionZh":"在内部","glossesEn":["inside area, organization"],"examples":[{"english":"to come from within the city/country","chinese":"来自城内/国内"},{"english":"to promote people from within","chinese":"提拔自己人"}]},{"id":"within:o:f39e65986d2a","label":"adv.","definitionZh":"在内心","glossesEn":["inside self"],"examples":[{"english":"beauty coming from within","chinese":"内在美"}]}]}}}