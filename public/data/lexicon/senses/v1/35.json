 pace","chinese":"他们快速出发了"}]},{"id":"tidy:o:8bc404275f1e","label":"v. refl.","definitionZh":"梳理打扮"},{"id":"tidy:o:b2fa29df2783","label":"n.","definitionZh":"盛零碎物品的","registers":["British"],"examples":[{"english":"a desk tidy","chinese":"案头文具盒"}]}]},"touring":{"senses":[{"id":"touring:o:11e90685ee59","label":"n.","definitionZh":"旅行","examples":[{"english":"to like touring","chinese":"喜欢旅游"}]},{"id":"touring:o:4258a39df2be","label":"adj.","definitionZh":"巡回的","examples":[{"english":"a touring rugby team","chinese":"进行巡回比赛的橄榄球队"},{"english":"a touring theatre company","chinese":"巡回演出的剧团"}]}]},"tundra":{"senses":[{"id":"tundra:o:02ba4ef309eb","label":"n.","definitionZh":"冻原"}]},"watercourse":{"senses":[{"id":"watercourse:o:f1e04b5b908c","label":"n.","definitionZh":"水道"}]},"wrought":{"senses":[{"id":"wrought:o:eba743bbb280","label":"adj.","definitionZh":"锻的","glossesEn":["beaten"],"contexts":["metal"]},{"id":"wrought:o:45b6a9afbc52","label":"adj.","definitionZh":"制作精良的","glossesEn":["devised"],"contexts":["music","plot","essay"],"examples":[{"english":"well/finely wrought","chinese":"制作精良的；精心构思的"}]}]}}}