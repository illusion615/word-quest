efore","chinese":"很久以前"},{"english":"it's never happened before","chinese":"这事以前从未发生过"},{"english":"have you been to India before?","chinese":"你去过印度吗？"}]},{"id":"before:o:3f61aeafb511","label":"adv.","definitionZh":"已经","glossesEn":["already"]},{"id":"before:o:54e714bf92e9","label":"adv.","definitionZh":"在前面","glossesEn":["preceding"],"examples":[{"english":"that page and the one before","chinese":"这一页和前面的一页"}]},{"id":"before:o:306582e355d2","label":"adv.","definitionZh":"提前","glossesEn":["ahead"],"registers":["archaic"],"examples":[{"english":"to ride before","chinese":"在前面骑马"}]},{"id":"before:o:f16272117914","label":"conj.","definitionZh":"在…以前","glossesEn":["prior to"],"examples":[{"english":"before I go, I would like to say that …","chinese":"我走以前想说…"},{"english":"before you can say Jack Robinson","chinese":"说时迟，那时快"},{"english":"before you know where you are …","chinese":"突然…"}]},{"id":"before:o:0eb118d8ad8c","label":"conj.","definitionZh":"到…时","glossesEn":["until"],"examples":[{"english":"it will be years before I earn that much money!","chinese":"我得到猴年马月才能挣到那么多钱！"}]},{"id":"before:o:519ac9135c3c","label":"conj.","definitionZh":"不然","glossesEn":["in threats or warnings"],"examples":[{"english":"get out of here before I call the police!","chinese":"走开，不然我叫警察了！"}]},{"id":"before:o:63ba041c0b39","label":"conj.","definitionZh":"以便","glossesEn":["as necessary condition"],"examples":[{"english":"you have to show your ticket before they'll let you in","chinese":"你得凭票入内"},{"english":"do it before you forget","chinese":"尽早动手，免得忘了"}]},{"id":"before:o:e8eb38dd0f36","label":"conj.","definitionZh":"以免","glossesEn":["in order to prevent"]},{"id":"before:o:c6b308e26b2c","label":"conj.","definitionZh":"不愿","glossesEn":["rather than"],"examples":[{"english":"I'd die before I apologize","chinese":"我宁死也不道歉"},{"english":"he would die before admitting he was wrong","chinese":"他死也不肯认错"}]}]},"birth":{"senses":[{"id":"birth:o:6ec87a3ba1d5","label":"n.","definitionZh":"出生","glossesEn