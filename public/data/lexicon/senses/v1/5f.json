ossesEn":["at this or that very moment"],"examples":[{"english":"I'm just finishing the letter","chinese":"这封信我快写完了"},{"english":"I'm just off!","chinese":"我走了！"}]},{"id":"just:o:075e12e801bc","label":"adv.","definitionZh":"马上","glossesEn":["in a few moments"],"examples":[{"english":"I was just going to tell you when …","chinese":"我刚要告诉你，这时…"}]},{"id":"just:o:950adcc3250e","label":"adv.","definitionZh":"不久","glossesEn":["shortly"],"examples":[{"english":"he arrived just after","chinese":"他随后就到了"},{"english":"just before/after midnight","chinese":"就在午夜前/午夜后"},{"english":"I get nervous just before, but once I'm on stage, I'm fine","chinese":"就在刚才我还很紧张，但是一上了台，我就没事了"}]},{"id":"just:o:c3701c474740","label":"adv.","definitionZh":"只是","glossesEn":["simply"],"examples":[{"english":"it's not just my imagination","chinese":"这并非只是我的想象"},{"english":"there's just one method","chinese":"只有一种方法"},{"english":"I'm not angry, just disappointed","chinese":"我没有生气，只是失望"}]},{"id":"just:o:62bbb0db34b8","label":"adv.","definitionZh":"勉强地","glossesEn":["barely"],"examples":[{"english":"he's just 20","chinese":"他刚满20岁"},{"english":"he only just passed the exam","chinese":"他考试勉强及格"}]},{"id":"just:o:34a7cd77dc76","label":"adv.","definitionZh":"稍微","glossesEn":["slightly"],"examples":[{"english":"just over 20 kg","chinese":"20公斤刚过"},{"english":"just beyond or past or after the station","chinese":"刚过车站"},{"english":"the skirt comes just below the knee","chinese":"裙子刚过膝"}]},{"id":"just:o:5bc94fa5b259","label":"adv.","definitionZh":"确实","glossesEn":["absolutely"],"examples":[{"english":"that was just wonderful/delicious","chinese":"那简直太棒了/味道好极了"},{"english":"that's just typical!","chinese":"果然与众不同啊！"},{"english":"that's just great!","chinese":"棒极了！；真了不起！"}]},{"id":"just:o:21f44b6a2642","label":"adv.","definitionZh":"轻易地","glossesEn":["easily"],"examples":[{"english":"I can just imagine it","chinese":"我很容易想象这事"},{"english":"I can just smell the pine forests","chinese":"我一下子就闻到了松林的味道"}]},{"id":"just:o:1a2cd572d237","label":"adv.","definitionZh":"也许","glossesEn":["possibly"],"examples":[{"english":"it might or could just be true","chinese":"这件事也许是真的"}]},{"id":"just:o:58fc80323f66","label":"adv.","definitionZh":"正好","glossesEn":["equally"],"examples":[{"english":"just as big/well as …","chinese":"正好和…一样大/好"},{"english":"I can just as easily walk","chinese":"我一样可以毫不费力地步行"},{"english":"just as well","chinese":"无妨"}]},{"id":"just:o:e9eeef65d2d5","label":"adv.","definitionZh":"用于祈使句","glossesEn":["with imperatives"],"examples":[{"english":"just keep quiet!","chinese":"请保持安静！"},{"english":"just think! you could have been hurt!","chinese":"好好想想吧！你原本会受伤的！"},{"english":"just look at the time!","chinese":"请看看时间吧！"}]},{"id":"just:o:15c3d273bde9","label":"adv.","definitionZh":"用于请求","glossesEn":["in requests"],"examples":[{"english":"if I could just interrupt you","chinese":"打搅一下"},{"english":"if you could just hold this box","chinese":"请拿着这个盒子"},{"english":"could you just wait five minutes?","chinese":"请等5分钟好吗？"}]},{"id":"just:o:f1aaa63b204d","label":"adv.","definitionZh":"表示歉意","glossesEn":["in excuses"],"examples":[{"english":"I've just got a few things to do first","chinese":"我得先处理几件事"}]},{"id":"just:o:90903df71830","label":"adv.","definitionZh":"表示同意","glossesEn":["expressing agreement"],"examples":[{"english":"he's adorable! — isn't he just!","chinese":"他真可爱！──可不是吗！"}]},{"id":"just:o:4260258f70e5","label":"adv. phr.","definitionZh":"几乎","glossesEn":["almost"],"examples":[{"english":"just about cooked/finished","chinese":"差不多熟了/快完工了"},{"english":"are you ready? — just about","chinese":"你准备好了吗？──快了"},{"english":"just about everything/anything","chinese":"几乎每件事/任何事"}]},{"id":"just:o:b89124b31893","label":"adv. phr.","definitionZh":"大概","glossesEn":["approximately"],"examples":[{"english":"it's just about 10 o'clock","chinese":"现在大约是10点钟"},{"english":"I've had just about enough!","chinese":"我差不多吃饱了！；我受够了！"}]},{"id":"just:o:d4a40158a316","label":"adv. phr.","definitionZh"