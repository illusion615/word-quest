,{"id":"with:o:e2ecea236ebd","label":"prep.","definitionZh":"尽管","glossesEn":["despite"],"examples":[{"english":"with all her faults I still love her","chinese":"尽管她有种种缺点，我依然爱她"}]},{"id":"with:o:8472c367dde8","label":"prep.","definitionZh":"由…主演","glossesEn":["starring"],"examples":[{"english":"Casablanca with Humphrey Bogart","chinese":"由亨弗莱鲍嘉主演的《卡萨布兰卡》"}]},{"id":"with:o:afd617fb40e4","label":"prep.","definitionZh":"跟得上","glossesEn":["following mentally"],"registers":["informal"],"examples":[{"english":"I'm not with you","chinese":"我不明白你的意思"},{"english":"to be or get with it","chinese":"明白情况"},{"english":"you don’t seem very with it today","chinese":"你今天脑瓜子似乎不太管用"}]},{"id":"with:o:2d9f7e2e7684","label":"prep.","definitionZh":"与副词连用表示感叹","glossesEn":["in exclamations"],"examples":[{"english":"down with sb/sth","chinese":"打倒某人/取缔某物"},{"english":"on with the dance!","chinese":"继续跳舞吧！"},{"english":"away with you!","chinese":"滚开！"}]}]},"wreck":{"senses":[{"id":"wreck:o:d95043b0cc20","label":"n.","definitionZh":"失事","glossesEn":["event"],"domains":["Nautical"]},{"id":"wreck:o:d8ea49cf8040","label":"n.","definitionZh":"沉船","glossesEn":["ship"]},{"id":"wreck:o:9342ed52c17f","label":"n.","definitionZh":"撞毁的汽车","glossesEn":["car"]},{"id":"wreck:o:a50ebb5bf9d8","label":"n.","definitionZh":"撞毁的飞机","glossesEn":["plane"]},{"id":"wreck:o:4973210aad19","label":"n.","definitionZh":"受到严重损伤的人","glossesEn":["person"],"examples":[{"english":"a human wreck","chinese":"废人"}]},{"id":"wreck:o:a3f09c98ba57","label":"vt.","definitionZh":"毁坏","glossesEn":["destroy, damage"],"examples":[{"english":"to be wrecked by fire/by an explosion/in a crash","chinese":"被烧毁/炸毁/撞毁"},{"english":"to be wrecked","chinese":"失事；遇难"}]},{"id":"wreck:o:c7e0c7cc5ed4","label":"vt.","definitionZh":"彻底毁灭","glossesEn":["spoil"],"registers":["figurative"],"examples":[{"english":"you've wrecked my whole life/future!","chinese":"你毁了我的一生/前程！"}]}]}}}