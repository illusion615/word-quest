ormal","US"],"examples":[{"english":"to shoot craps/pool/dice","chinese":"玩双骰赌博/打落袋台球/掷骰子"}]},{"id":"shoot:o:425dea515167","label":"vt.","definitionZh":"注射","glossesEn":["inject"],"registers":["slang"],"contexts":["heroin","cocaine"]},{"id":"shoot:o:4d64fccc3619","label":"vi.","definitionZh":"开枪","glossesEn":["fire a gun"],"contexts":["soldier","marksman","huntsman"],"examples":[{"english":"to shoot to kill/wound","chinese":"开枪射杀/射伤"},{"english":"to shoot from the hip","chinese":"鲁莽行事"}]},{"id":"shoot:o:2106ef3a8376","label":"vi.","definitionZh":"射击","contexts":["aircraft","ship"]},{"id":"shoot:o:97cd00e425b6","label":"vi.","definitionZh":"射击","glossesEn":["use a gun"],"contexts":["marksman","huntsman"],"examples":[{"english":"he enjoys riding, fishing and shooting","chinese":"他喜欢骑马、钓鱼和射击"},{"english":"to shoot straight/accurately etc.","chinese":"打得直/准等"}]},{"id":"shoot:o:cb572bfdb8f3","label":"vi.","definitionZh":"发射","glossesEn":["fire bullets or arrows"]},{"id":"shoot:o:1136e3785b25","label":"vi.","definitionZh":"快速移动","glossesEn":["move suddenly"],"examples":[{"english":"the car shot past","chinese":"那辆车飞驰而过"},{"english":"a meteor shot across the sky","chinese":"一颗流星划过天空"},{"english":"the pain shot down or along his arm","chinese":"他突然感到胳膊一阵疼痛"}]},{"id":"shoot:o:f848a3dbbf2c","label":"vi.","definitionZh":"发芽","glossesEn":["sprout"],"contexts":["plant","bush","shrub"]},{"id":"shoot:o:717cdfbf775d","label":"vi.","definitionZh":"射门","glossesEn":["attempt to score"],"contexts":["player","forward"]},{"id":"shoot:o:79b5bec0a049","label":"vi.","definitionZh":"说出来","glossesEn":["speak out"],"registers":["informal"],"examples":[{"english":"if you've got something to tell me, shoot!","chinese":"如果你有话对我讲，那就说吧！"},{"english":"you shoot first","chinese":"你先说"}]},{"id":"shoot:o:8bb7e19351f4","label":"n.","definitionZh":"幼芽","glossesEn":["of plant"]},{"id":"shoot:o:bc1bc44cc65e","label":"n.","definitionZh":"狩猎活动","glossesEn":["shooting expedition"],"registers":["British"],"exa