sesEn":["closer in space or time, closer to state or condition"],"examples":[{"english":"seats towards the rear of the plane","chinese":"靠近机舱尾部的座位"},{"english":"towards midnight","chinese":"午夜时分"},{"english":"towards the end of the day/month/one's life","chinese":"接近黄昏/月底/生命结束"}]},{"id":"toward:o:f08753c3f271","label":"prep.","definitionZh":"对于","glossesEn":["in relation to"],"examples":[{"english":"our attitude towards death","chinese":"我们对死亡的态度"},{"english":"their policy towards Europe","chinese":"他们对欧洲的政策"},{"english":"to be friendly/hostile towards sb","chinese":"友好对待/敌视某人"}]},{"id":"toward:o:2e31f00b3327","label":"prep.","definitionZh":"用于","glossesEn":["as contribution to"],"examples":[{"english":"to put money towards one's education","chinese":"把钱用在教育上"},{"english":"to save towards a holiday","chinese":"攒钱好去度假"}]}]},"urchin":{"senses":[{"id":"urchin:o:4f29a3234ae5","label":"n.","definitionZh":"顽童","examples":[{"english":"a street urchin","chinese":"街头小乞丐"}]}]},"victor":{"senses":[{"id":"victor:o:4ca16e34b65e","label":"n.","definitionZh":"胜利者","examples":[{"english":"to emerge the victor","chinese":"胜出"}]}]},"whittle":{"senses":[{"id":"whittle:o:d852a448e0d4","label":"vt.","definitionZh":"削","glossesEn":["cut"],"contexts":["piece of wood","stick"]},{"id":"whittle:o:cd63b6d9f04c","label":"vt.","definitionZh":"削成","glossesEn":["create"],"contexts":["peg","walking stick"]}]}}}