":{"senses":[{"id":"textbook:o:13dc15aecf3f","label":"n.","definitionZh":"课本"},{"id":"textbook:o:91112d73d1e3","label":"adj.","definitionZh":"规范的","contexts":["landing","description"],"examples":[{"english":"a textbook example","chinese":"范例"}]}]},"throne":{"senses":[{"id":"throne:o:eb26b5ef6e9d","label":"n.","definitionZh":"宝座","glossesEn":["chair"]},{"id":"throne:o:68442e72bbd0","label":"n.","definitionZh":"王权","glossesEn":["power"],"examples":[{"english":"the throne","chinese":"王位"},{"english":"to be on the throne","chinese":"在位"},{"english":"to ascend (to)/abdicate from the throne","chinese":"登基/退位"}]}]},"timely":{"senses":[{"id":"timely:o:08fb01aa11bb","label":"adj.","definitionZh":"及时的","glossesEn":["occurring at the right time"],"examples":[{"english":"the timely arrival of the fire brigade","chinese":"消防队的及时赶到"}]},{"id":"timely:o:4f469082f9b1","label":"adj.","definitionZh":"适时的","glossesEn":["opportune"]}]},"topsoil":{"senses":[{"id":"topsoil:o:da9c67c9cd06","label":"n.","definitionZh":"表土"}]},"totality":{"senses":[{"id":"totality:o:be294cae3e97","label":"n.","definitionZh":"全体","examples":[{"english":"let's consider the universe in its totality","chinese":"让我们把宇宙看作一个整体"}]}]},"troubling":{"senses":[{"id":"troubling:o:d574c82580b6","label":"n.","definitionZh":"问题","glossesEn":["problems"],"examples":[{"english":"what's the trouble?","chinese":"出什么事了？"},{"english":"to cause or give (sb) trouble","chinese":"（给某人）带来困难"},{"english":"to make trouble for sb","chinese":"给某人制造麻烦"}]},{"id":"troubling:o:094455de03f3","label":"n.","definitionZh":"纷争","glossesEn":["discord"],"examples":[{"english":"relationship troubles","chinese":"家庭矛盾"},{"english":"the police had come expecting trouble and were in full riot gear","chinese":"警察预料到会有暴乱，所以身穿全套防暴服赶来"},{"english":"to be looking for trouble","chinese":"寻衅滋事"}]},{"id":"troubling:o:89a8bd597708","label":"n.","definitionZh":"打斗","glossesEn":["fighting"]},{"id":"troubling:o:5db2b8fba610","label":"n.","definitionZh":"动乱","glossesEn":["rioting"]},{"id":"troubling:o:5ab531692a1a","label":"n.","definitionZh":"不便","glossesEn":["effort, inconvenience"],"examples":[{"english":"it's no trouble (at all)!","chinese":"（一点儿都）不麻烦！"},{"english":"it's so much trouble preparing all the ingredients","chinese":"准备所有的配料太费事了"},{"english":"to go to a lot of trouble (to do sth)","chinese":"不辞辛劳（做某事）"}]},{"id":"troubling:o:328d04709f0f","label":"n.","definitionZh":"病痛","domains":["Medicine"],"examples":[{"english":"heart trouble","chinese":"心脏病"},{"english":"back trouble","chinese":"背痛"},{"english":"my leg's been giving me trouble","chinese":"我的腿一直疼"}]},{"id":"troubling:o:ce5862229721","label":"n. pl.","definitionZh":"烦恼","glossesEn":["worries, woes"],"examples":[{"english":"to tell sb one's troubles","chinese":"向某人诉苦"},{"english":"to listen to sb's troubles","chinese":"听某人诉苦"},{"english":"may all your troubles be little ones!","chinese":"但愿你们的烦恼都不是烦恼！"}]},{"id":"troubling:o:b43fc9405e0b","label":"n. pl.","definitionZh":"北爱尔兰民族主义者与反自治主义者、新教徒与天主教徒之间的暴力冲突","registers":["British"],"domains":["Politics"],"examples":[{"english":"the troubles","chinese":"动乱时期"}]},{"id":"troubling:o:6687eed5f52c","label":"vt.","definitionZh":"困扰","glossesEn":["worry"],"contexts":["problem","anxiety"],"examples":[{"english":"I wonder what's troubling her","chinese":"我不知道什么事让她愁眉苦脸"},{"english":"it is going to cost a lot of money, but don't let that trouble you","chinese":"这要花很多钱，但你不要担心"}]},{"id":"troubling:o:72ea945feae9","label":"vt.","definitionZh":"麻烦","glossesEn":["bother"],"examples":[{"english":"sorry to trouble you! is this your car?","chinese":"对不起，打扰您一下！这是您的车吗？"},{"english":"may I trouble you for the butter/your signature?","chinese":"麻烦递一下黄油/签一下名好吗？"}]},{"id":"troubling:o:781078354e61","label":"vt.","definitionZh":"使疼痛","glossesEn":["cause pain, discomfort"],"contexts":["part of body","illness"],"examples":[{"english":"my back is troubling me again","chinese":"我的背又开始痛了"},{"english":"he's been troubled by a nasty cough","chinese":"他一直在剧烈地咳嗽"}]},{"id":"troubling:o:19d8eb3ebbc0","label":"v. refl.","definitionZh":"劳神","examples":[{"english":"don't trouble yourself!","chinese":"别费心了！"},{"english":"they didn't trouble themselves to explain","chinese":"他们没有费神去解释"}]},{"id":"troubling:o:6f1dbeba2df0","label":"vi.","definitionZh":"费心","glossesEn":["bother"],"examples":[{"english":"don't trouble","chinese":"别费心了"},{"english":"don't trouble about me: I'll be OK","chinese":"不用担心我，我不会有事的"},{"english":"don't trouble to meet me, I'll get a taxi","chinese":"不必来接我，我打的好了"}]},{"id":"troubling:o:f1e71e548c95","label":"vi.","definitionZh":"忧虑","glossesEn":["worry"],"examples":[{"english":"she was too concerned with her own feelings to trouble about mine","chinese":"她一味地想着自己的感受，都不关心我怎么想"}]}]},"typical":{"senses":[{"id":"typical:o:7b940d7b5d81","label":"adj.","definitionZh":"典型的","glossesEn":["usual, representative"],"contexts":["case","example","symptoms","feature","response"],"examples":[{"english":"to be typical of the period/area","chinese":"是这个时期/地区的特征"},{"english":"it's (all too) typical of him to be late","chinese":"他这人就是爱迟到"},{"english":"(that's) typical!","chinese":"一贯如此！"}]},{"id":"typical:o:f1243ce0252c","label":"adj.","definitionZh":"特有的","glossesEn":["characteristic"],"contexts":["behaviour","modesty","rudeness","generosity"]}]},"vaccinate":{"senses":[{"id":"vaccinate:o:4bb0c12db20e","label":"vt.","definitionZh":"给…接种疫苗","examples":[{"english":"to vaccinate sb against tetanus","chinese":"给某人接种破伤风疫苗"}]}]},"vest":{"senses":[{"id":"vest:o:c4b5473b3dd3","label":"n.","definitionZh":"汗衫","glossesEn":["undergarment"],"registers":["British"]},{"id":"vest:o:689593aa6f5b","label":"n.","definitionZh":"背心","glossesEn":["sleeveless garment"],"examples":[{"english":"a bullet-proof vest","chinese":"防弹背心"}]},{"id":"vest:o:af3f1261b88d","label":"n.","definitionZh":"马甲","glossesEn":["waistcoat"],"registers":["US"]},{"id":"vest:o:02d32bf3d0f5","label":"vt.","definitionZh":"授予","contexts":["authority","right"],"examples":[{"english":"the powers vested in sth/sb","chinese":"属于某物/某人的权力"},{"english":"to vest the ownership of sth in sb","chinese":"使某人拥有某物"}]}]}}}