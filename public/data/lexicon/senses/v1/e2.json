h":"whether or not people are happy is of little importance","chinese":"人们高兴与否无关紧要"},{"english":"everyone, whether students or townspeople, celebrated","chinese":"无论是学生还是市民，人人都在庆祝"}]}]},"which":{"senses":[{"id":"which:o:ad55654f5226","label":"pron.","definitionZh":"哪一个","glossesEn":["what one"],"examples":[{"english":"which one","chinese":"哪一个"},{"english":"I know which ones you'd like","chinese":"我知道你想要哪一些"},{"english":"which is the shortest route?","chinese":"哪条路最近？"}]},{"id":"which:o:3705bd6b401f","label":"pron.","definitionZh":"哪一些","glossesEn":["what ones"]},{"id":"which:o:528929b2d555","label":"pron.","definitionZh":"…的那个","glossesEn":["specifying preceding noun"],"examples":[{"english":"the painting which hangs in the sitting room","chinese":"挂在客厅里的那幅画"},{"english":"the contract which he's spoken about or about which he's spoken","chinese":"他谈到的那份合同"}]},{"id":"which:o:539038b8b6fb","label":"pron.","definitionZh":"这个","glossesEn":["adding to preceding clause"],"examples":[{"english":"…, which reminds me …","chinese":"这使我想起…"},{"english":"we'll be moving, before which we need to …","chinese":"我们要搬迁了，在这之前我们需要…"},{"english":"his movie, which won several awards, is based on real life events","chinese":"他的影片是根据真实事件拍摄的，获过数个奖项"}]},{"id":"which:o:cda5c4d7c9fb","label":"det.","definitionZh":"哪个","glossesEn":["in questions","referring to one"],"examples":[{"english":"which way is the wind blowing?","chinese":"风是朝哪个方向刮的？"},{"english":"which books?","chinese":"哪些书？"},{"english":"which one of the children?","chinese":"哪个孩子？"}]},{"id":"which:o:034ce136eba7","label":"det.","definitionZh":"哪些","glossesEn":["referring to several"]},{"id":"which:o:9d69316e9fd1","label":"det.","definitionZh":"那个","glossesEn":["in relative clauses"],"examples":[{"english":"in which case","chinese":"在那种情况下"},{"english":"he left, during which time no one spoke","chinese":"他离开了，其间没有一个人说话"},{"english":"he failed to apologize, for which mistake he paid dearly","chinese":"他没有道歉，因为这个过失他付出了沉重的代价"}]}]}}}