17b885208d68","label":"n.","definitionZh":"全胜","glossesEn":["comprehensive win"]},{"id":"sweep:o:ab82bc9ad8bc","label":"n. pl.","definitionZh":"收视率调查","registers":["US"],"examples":[{"english":"the sweeps","chinese":"收视率调查"}]}]},"thank":{"senses":[{"id":"thank:o:652d934a79b5","label":"vt.","definitionZh":"感谢","examples":[{"english":"you've only got yourself to thank for that!","chinese":"这事只能怪你自己！"},{"english":"there's the bus, thank goodness","chinese":"公共汽车来了，谢天谢地"}]}]},"them":{"senses":[{"id":"them:o:af17aac3ff25","label":"pron.","definitionZh":"他们","glossesEn":["referring to men, boys, people in general"],"examples":[{"english":"I know them","chinese":"我认识他们"},{"english":"both of them work in London","chinese":"他们俩都在伦敦工作"}]},{"id":"them:o:c79c316f21c8","label":"pron.","definitionZh":"她们","glossesEn":["referring to women, girls"]},{"id":"them:o:8314691ca88e","label":"pron.","definitionZh":"它们","glossesEn":["referring to animals, things"]},{"id":"them:o:530dfa914021","label":"pron.","definitionZh":"指性别不详者","glossesEn":["referring to person or animal of unspecified sex"],"examples":[{"english":"I phoned a friend and asked them to help","chinese":"我给一个朋友打了电话求助"}]}]},"thumb":{"senses":[{"id":"thumb:o:92ac34ee5a54","label":"n.","definitionZh":"拇指","glossesEn":["human finger"],"examples":[{"english":"to be all (fingers and) thumbs","chinese":"笨手笨脚"},{"english":"to be under sb's thumb","chinese":"受某人摆布"}]},{"id":"thumb:o:38eee04cd53d","label":"n.","definitionZh":"第一指","glossesEn":["animal finger"]},{"id":"thumb:o:86f8b74d68c9","label":"n.","definitionZh":"手套的","glossesEn":["part of glove"]},{"id":"thumb:o:dc6e3c80b37d","label":"vt.","definitionZh":"用拇指翻动","glossesEn":["turn pages of"],"contexts":["book","magazine"]},{"id":"thumb:o:f5f3f2271973","label":"vt.","definitionZh":"用拇指按","glossesEn":["touch"],"contexts":["button","nose"],"examples":[{"english":"to thumb one's nose at sb/sth","chinese":"对某人/某事物不屑一顾"}]},{"id":"thumb:o:edd8183c768e","label":"vt.","definitionZh":"竖