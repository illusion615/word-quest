ct"]},{"id":"right:o:fd82ad220ba9","label":"adj.","definitionZh":"合适的","glossesEn":["appropriate"],"contexts":["choice","conditions"],"examples":[{"english":"to choose the right candidate","chinese":"选择合适的候选人"},{"english":"is this the right train for Dublin?","chinese":"这是去都柏林的火车吗？"},{"english":"to be in the right place at the right time","chinese":"在适当的时间出现在适当的地点"}]},{"id":"right:o:0356e9e2559b","label":"adj.","definitionZh":"对头的","contexts":["decision","direction","road"]},{"id":"right:o:35cc4ff5ee90","label":"adj.","definitionZh":"关键的","glossesEn":["socially important"],"examples":[{"english":"to know the right people","chinese":"认识头面人物"},{"english":"to go to the right schools","chinese":"上知名学校"},{"english":"to be seen in the right places","chinese":"在重要场合出现"}]},{"id":"right:o:f4e14a35a782","label":"adj.","definitionZh":"正常的","glossesEn":["functioning properly"],"examples":[{"english":"sb/sth is not quite right","chinese":"某人/某事物不太正常"},{"english":"I don't feel quite right today","chinese":"我今天感觉不太舒服"},{"english":"to put or set sth right","chinese":"使…恢复正常；纠正"}]},{"id":"right:o:cd8ef161ecf9","label":"adj.","definitionZh":"右边的","glossesEn":["not left"],"examples":[{"english":"my right foot","chinese":"我的右脚"},{"english":"the right bank","chinese":"右岸"},{"english":"take a right turn at the intersection","chinese":"在十字路口右拐"}]},{"id":"right:o:3d7d86cf643e","label":"adj.","definitionZh":"完全的","glossesEn":["complete"],"registers":["informal","British"],"examples":[{"english":"I felt a right idiot!","chinese":"我感觉像个十足的傻瓜！"},{"english":"it's a right mess","chinese":"真是一团糟"}]},{"id":"right:o:fe7e1fb51034","label":"adj.","definitionZh":"准备好的","glossesEn":["ready"],"registers":["informal","British"],"examples":[{"english":"are you right?","chinese":"你准备好了吗？"}]},{"id":"right:o:b1856cf41658","label":"adj.","definitionZh":"直的","domains":["Mathematics"],"examples":[{"english":"a right pyramid","chinese":"直立棱锥"}]},{"id":"right:o:b998c68f0e0a","label":"adv.","definitionZh":"正好","glossesEn":["exactly"],"examples":[{"english":"right in the middle of the room","chinese":"恰好在房间的中央"},{"english":"the bullet hit him right in the forehead","chinese":"子弹正好击中了他的前额"},{"english":"right now","chinese":"立即；此刻"}]},{"id":"right:o:a1cbc72eecd4","label":"adv.","definitionZh":"直接地","glossesEn":["directly"],"examples":[{"english":"he was standing right behind her","chinese":"他就站在她身后"},{"english":"go right home","chinese":"直接回家"}]},{"id":"right:o:85826c76ef03","label":"adv.","definitionZh":"完全地","glossesEn":["completely"],"examples":[{"english":"a wall goes right around the garden","chinese":"一面墙整个围住了花园"},{"english":"go right to the end of the street","chinese":"一直走到街道的尽头"},{"english":"we're right behind you!","chinese":"我们完全支持你！"}]},{"id":"right:o:2860bc6b8974","label":"adv.","definitionZh":"立即","glossesEn":["immediately"],"examples":[{"english":"I'll be right back","chinese":"我马上回来"}]},{"id":"right:o:e6a6f4ece4bd","label":"adv.","definitionZh":"正确地","glossesEn":["correctly"],"examples":[{"english":"I guessed right","chinese":"我猜对了"},{"english":"if I remember right","chinese":"如果我没记错的话"},{"english":"you did right not to speak to her","chinese":"你不跟她说话是对的"}]},{"id":"right:o:5225a7063edb","label":"adv.","definitionZh":"在右边","glossesEn":["on the right"],"examples":[{"english":"to go or turn right","chinese":"向右转"},{"english":"keep right","chinese":"靠右行"},{"english":"eyes right!","chinese":"向右看齐！"}]},{"id":"right:o:7425d2bc251d","label":"adv.","definitionZh":"向右","glossesEn":["to the right"]},{"id":"right:o:1e6b78449ada","label":"adv.","definitionZh":"非常","glossesEn":["very"],"examples":[{"english":"it's right spooky in there!","chinese":"这里太诡异了！"},{"english":"he knew right well what was happening","chinese":"他很清楚正在发生的事"}]},{"id":"right:o:8c95604adc6e","label":"int.","definitionZh":"是的","glossesEn":["expressing agreement"],"examples":[{"english":"you may find it hurts a little at first — right","chinese":"一开始你会觉得有点疼──是啊"},{"english":"I'll have a whisky and soda — ri